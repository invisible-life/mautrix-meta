FROM golang:1.27.4-alpine3.24 AS builder
RUN apk add --no-cache git ca-certificates build-base su-exec olm-dev
WORKDIR /build
COPY . .
RUN go test ./pkg/igconnector ./pkg/instameow ./pkg/messagix/dgw
RUN ./build-ig.sh

# Keep the runtime and dependencies identical to the previous deployment.
FROM dock.mau.dev/mautrix/meta@sha256:5e8e8accfc735aed330d29f66e545c478ed2890548168f5f192d5edbe7cb860b
COPY --from=builder /build/mautrix-instagram /usr/bin/mautrix-meta
