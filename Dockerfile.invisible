# The upstream production builder includes the static libolm archives.
FROM dock.mau.dev/tulir/gomuks-build-docker@sha256:8cc6453dde63ac865cab8410ad39f72376c38ef977284a87be3553bc22dd5de6 AS builder
WORKDIR /build
COPY . .
RUN go test ./pkg/igconnector ./pkg/instameow ./pkg/messagix/dgw
RUN go build -ldflags "-s -w -linkmode external -extldflags -static -X main.Commit=$(git rev-parse HEAD) -X main.BuildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ) -X maunium.net/go/mautrix.GoModVersion=v0.33.0" -o mautrix-instagram ./cmd/mautrix-instagram

# Keep the runtime and dependencies identical to the previous deployment.
FROM dock.mau.dev/mautrix/meta@sha256:5e8e8accfc735aed330d29f66e545c478ed2890548168f5f192d5edbe7cb860b
COPY --from=builder /build/mautrix-instagram /usr/bin/mautrix-meta
RUN /usr/bin/mautrix-meta --version
